{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "description": [
    "Tooling and lockfile refreshes merge themselves once CI is green.",
    "Runtime libraries, climate-ref, the interpreter, images and every major wait for a review."
  ],
  "timezone": "Australia/Melbourne",
  "dependencyDashboardTitle": "Renovate Dependency Dashboard",
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "schedule": ["on monday"],
  "platformAutomerge": false,
  "automergeType": "pr",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on monday"],
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "groupName": null
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "addLabels": ["frontend"]
    },
    {
      "matchManagers": ["pep621", "pyenv"],
      "addLabels": ["backend"]
    },
    {
      "matchManagers": ["npm"],
      "groupName": "frontend dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "frontend dev tooling",
      "automerge": true
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "backend dependencies"
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "groupName": "backend dev tooling",
      "automerge": true
    },
    {
      "description": "The core library sets what the API can serve, so it is reviewed on its own",
      "matchDepNames": ["climate-ref"],
      "groupName": "climate-ref",
      "schedule": ["at any time"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "ci tooling",
      "automerge": true
    },
    {
      "description": "Biome is pinned in both package.json and the CI workflow, so they move together",
      "matchDepNames": ["@biomejs/biome", "biome"],
      "groupName": "ci tooling",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "container images"
    },
    {
      "description": "A major is never hidden inside a batch and never merges itself",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "automerge": false
    }
  ]
}
